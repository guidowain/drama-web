# Admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-password

# JWT secret — generate a random 32+ char string
JWT_SECRET=your-very-secret-jwt-key-change-this

# Google Analytics 4 measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Analytics 4 numeric property ID for the Data API
GOOGLE_ANALYTICS_PROPERTY_ID=123456789

# Optional: Google Analytics API access using OAuth with a real Google user
GOOGLE_ANALYTICS_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_ANALYTICS_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_ANALYTICS_REFRESH_TOKEN=your-oauth-refresh-token

# Optional alternative: Google Analytics API access using a GA4-authorized service account
# GOOGLE_ANALYTICS_SERVICE_ACCOUNT_KEY={"client_email":"analytics@project.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"}
# GOOGLE_ANALYTICS_SERVICE_ACCOUNT_EMAIL=analytics@project.iam.gserviceaccount.com
# GOOGLE_ANALYTICS_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n

# Drama Meet — repo PRIVADO donde se guardan las reuniones y las respuestas.
# Tiene que ser un repo aparte de drama-web: drama-web es público (expondría los
# mails de los invitados) y además cada respuesta dispararía un deploy del sitio.
# Sin esta variable, en local se guarda en ./.meet-data y en Vercel se rompe a propósito.
MEET_GITHUB_REPO=guidowain/drama-meet-data
MEET_GITHUB_BRANCH=main
# Si no se define, reusa GITHUB_CONTENT_TOKEN. El token necesita acceso de
# escritura a ese repo privado.
# MEET_GITHUB_TOKEN=

# Horarios internos — /horarios
# El PIN y los secretos reales se configuran en .env.local y en Vercel.
HORARIOS_PIN=tu-pin-de-cuatro-digitos
HORARIOS_JWT_SECRET=otro-secreto-largo-y-aleatorio
HORARIOS_SYNC_SECRET=secreto-compartido-con-el-worker-local

# En producción se guarda un único snapshot JSON en un repo privado. En local,
# si estas variables no están, se usa ./.horarios-data/schedule.json.
HORARIOS_GITHUB_REPO=guidowain/drama-horarios-data
HORARIOS_GITHUB_BRANCH=main
# HORARIOS_GITHUB_TOKEN=

# Worker local Qwen + navegador. El worker carga .env.local automáticamente.
OLLAMA_BASE_URL=http://127.0.0.1:11434
HORARIOS_QWEN_MODEL=qwen3.6:27b
HORARIOS_API_URL=http://127.0.0.1:3000/api/horarios/sync
